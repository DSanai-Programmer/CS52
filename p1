// Part 1

// Function: roll
// Purpose: Roll a 6 sided die
// Input: None
// Output: A random number between 1 and 6
// Side effect: None
int roll()
{
	int diceNumber = (std::rand() % 6) + 1;
	return diceNumber;
}

// Function: roll
// Purpose: Roll the inputted number of dice and store the results in the inputted array
// Input: 1. A array of integers to eventually hold random numbers between 1 and 6
//		  2. An integer indicating the size of the array and how many random numbers to generate
// Output: None
// Side effect: None
void roll(int die[], int count)
{
	for (int index = 0; index < count; index++)
	{
		die[index] = roll();
	}
}

// Function: displayRoll
// Purpose: Uses COUT to display numbers in the array
// Input: 1. A array of integers
//		  2. An integer indicating the size of the array
// Output: None
// Side effect: Uses COUT so numbers appear as [ 1, 5, 3, 3, 5 ]
//				Assuming the array had 5 numbers in it
void displayRoll(int die[], int count)
{
	for (int index = 0; index < count; index++)
	{
		std::cout << die[index];
		if (index != count - 1)
		{
			std::cout << ", ";
		}
	}
}

// Function: computeBetResult
// Purpose: Determine how much was won with a Chuck-a-Luck roll 
// Input: 1. A 3 integer array of random numbers between 1 and 6
//		  2. The size of the prior array, though it should be 3
//		  3. The amount of money the user is betting
//		  4. The number (between 1 and 6) that the user bet on
// Output: The amount of money the user won, based on the chuck-a-luck rules
//		   Check the assignment write up for the rules
// Side effect: Will use COUT to display how many dice the user matched
int computeBetResult(int die[], int dieCount, int betAmount, int betNumber)
{
	int payoutReturn = 0;
	int numberOccurrence = 0;
	for (int index = 0; index < 3; index++)
	{
		if (betNumber == die[index])
			numberOccurrence += 1;
	}

	if (numberOccurrence == 0)
		payoutReturn == 0;
	else if (numberOccurrence == 1)
		payoutReturn = 1 * betAmount + betAmount;
	else if (numberOccurrence == 2)
		payoutReturn = 3 * betAmount + betAmount;
	else if (numberOccurrence == 3)
		payoutReturn = 10 * betAmount + betAmount;

	return payoutReturn;
}

