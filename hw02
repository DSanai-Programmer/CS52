#include <iostream>
#include <string>
#include <cmath>
int main()
{
	// Part 1

	std::cout << "Enter the vehicle's purchase price: ";
	double vehiclePurchasePrice = 0.0;
	std::cin >> vehiclePurchasePrice;
	// std::cout << vehiclePurchasePrice;
	std::cout << "Enter the down payment for the vehicle: ";
	double vehicleCashDownPayment = 0.0;
	std::cin >> vehicleCashDownPayment;
	// std::cout << vehicleCashDownPayment;
	std::cout << "Enter the sales tax on the transaction (for 8.25% tax, enter 8.25): ";
	double vehicleSalesTax = 0.0;
	std::cin >> vehicleSalesTax;
	// std::cout << vehicleSalesTax;
	std::cout << "Do you have a vehicle to trade in? (y/n): ";
	std::string stringYesOrNo = "";
	std::cin >> stringYesOrNo;
	// std::cout << stringYesOrNo;
	double vehicleTradeIn = 0.0;
	double vehicleTotalDownPayment = vehicleCashDownPayment;
	double vehicleLoanAmount = 0.0;
	vehicleLoanAmount = (vehiclePurchasePrice - vehicleTotalDownPayment) * (1 + (vehicleSalesTax / 100));

	if ((stringYesOrNo == "y") || (stringYesOrNo == "Y"))
	{
		std::cout << "Enter the trade-in value of your current vehicle: ";
		std::cin >> vehicleTradeIn;
		// std::cout << vehicleTradeIn;
		std::cout << "Enter the amount owed on your current vehicle: ";
		double vehicleAmountOwnedOnTrade = 0.0;
		std::cin >> vehicleAmountOwnedOnTrade;
		// std::cout << vehicleAmountOwnedOnTrade;
		vehicleTotalDownPayment = vehicleCashDownPayment + (vehicleTradeIn - vehicleAmountOwnedOnTrade);
		vehicleLoanAmount = (vehiclePurchasePrice - vehicleTotalDownPayment) * (1 + (vehicleSalesTax / 100));
	}

	std::cout << "Your overall down payment is $" << vehicleTotalDownPayment << std::endl;
	std::cout << "Your overall loan amount is $" << vehicleLoanAmount << std::endl;
	
	std::cout << "*****************************" << std::endl;


	// Part 2

	std::cout << "Enter the length of your loan..." << std::endl;
	std::cout << "\t1: 3 years" << std::endl;
	std::cout << "\t2: 4 years" << std::endl;
	std::cout << "\t3: 5 years" << std::endl;
	std::cout << "\t4: 6 years" << std::endl;
	std::cout << "Select an option: ";
	int userOption = 0;
	std::cin >> userOption;

	// The scope for switch works the same as that of if statements: we cannot use a variable we declare in a case outside of it
	// However, if we declare a variable before the switch statement, any updates made to the variable within a case will persist
	// outside of the scope (i.e. mutable)
	int vehicleNumberOfPayments = 0;
	switch (userOption)
	{ 
	case 1:
		vehicleNumberOfPayments = 36;
		std::cout << "You selected a 3 year loan with a total of 36 monthly payments." << std::endl;
		break;
	case 2:
		vehicleNumberOfPayments = 48;
		std::cout << "You selected a 4 year loan with a total of 48 monthly payments." << std::endl;
		break;
	case 3:
		vehicleNumberOfPayments = 60;
		std::cout << "You selected a 5 year loan with a total of 60 monthly payments." << std::endl;
		break;
	case 4:
		vehicleNumberOfPayments = 72;
		std::cout << "You selected a 6 year loan with a total of 72 monthly payments." << std::endl;
		break;
	default:
		std::cout << "You selected a 5 year loan with a total of 60 monthly payments." << std::endl;
		break;
	}

	std::cout << "*****************************" << std::endl;


	// Part 3

	double vehiclePercentDown = (vehicleTotalDownPayment / vehiclePurchasePrice) * 100;
	double vehicleInterestRate = 0.0;

	// Next time, instead of using several if and if else statements, use one set of if and if else corresponding to whether it was
	// less than 20 or equal to or more than 20
	// Within the if and the if else, have a switch statement that corresponds to whether the userOption was 1, 2, 3 or 4

	 if (userOption == 1 && vehiclePercentDown < 20)
	{
		 vehicleInterestRate = 5.65;
		 std::cout << "With " << vehiclePercentDown << "% down and a 3 year loan, we can offer you an interest rate of 5.65%" << std::endl;
	}
	 else if (userOption == 1 && vehiclePercentDown >= 20)
	 {
		 vehicleInterestRate = 5.52;
		 std::cout << "With " << vehiclePercentDown << "% down and a 3 year loan, we can offer you an interest rate of 5.52%" << std::endl;
	 }

	 if (userOption == 2 && vehiclePercentDown < 20)
	 {
		 vehicleInterestRate = 5.89;
		 std::cout << "With " << vehiclePercentDown << "% down and a 4 year loan, we can offer you an interest rate of 5.89%" << std::endl;
	 }
	 else if (userOption == 2 && vehiclePercentDown >= 20)
	 {
		 vehicleInterestRate = 5.74;
		 std::cout << "With " << vehiclePercentDown << "% down and a 4 year loan, we can offer you an interest rate of 5.74%" << std::endl;
	 }

	 if (userOption == 3 && vehiclePercentDown < 20)
	 {
		 vehicleInterestRate = 6.11;
		 std::cout << "With " << vehiclePercentDown << "% down and a 5 year loan, we can offer you an interest rate of 6.11%" << std::endl;
	 }
	 else if (userOption == 3 && vehiclePercentDown >= 20)
	 {
		 vehicleInterestRate = 5.99;
		 std::cout << "With " << vehiclePercentDown << "% down and a 5 year loan, we can offer you an interest rate of 5.99%" << std::endl;
	 }

	 if (userOption == 4 && vehiclePercentDown < 20)
	 {
		 vehicleInterestRate = 6.41;
		 std::cout << "With " << vehiclePercentDown << "% down and a 6 year loan, we can offer you an interest rate of 6.41%" << std::endl;
	 }
	 else if (userOption == 4 && vehiclePercentDown >= 20)
	 {
		 vehicleInterestRate = 6.24;
		 std::cout << "With " << vehiclePercentDown << "% down and a 6 year loan, we can offer you an interest rate of 6.24%" << std::endl;
	 }

	 std::cout << "*****************************" << std::endl;


	 // Part 4

	 double vehicleMonthlyInterest = vehicleInterestRate / 1200;
	 double vehicleMonthlyPaymentNumerator = vehicleMonthlyInterest;
	 double vehicleMonthlyPaymentDenominator = 1 - std::pow(1 + vehicleMonthlyInterest, -vehicleNumberOfPayments);
	 // Exponent function is used as std::pow(base, power)

	 double vehicleMonthlyPayment = vehicleLoanAmount * (vehicleMonthlyPaymentNumerator / vehicleMonthlyPaymentDenominator);

	 std::cout << "Your estimated monthly payment would be $" << vehicleMonthlyPayment << " a month.";


	return 0;
}
